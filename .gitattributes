# One line ending in the repository, whatever the editor on the machine
# writes: a Windows checkout and a Linux checkout then diff as the same files,
# and `git add` stops warning about every one of them.
* text=auto eol=lf

# Shell scripts run on Linux and macOS runners, and under WSL from a Windows
# checkout: a CRLF line ending breaks the shebang there.
*.sh text eol=lf

# PowerShell 5.1 reads a script as the ANSI codepage unless it starts with a
# BOM, and expects Windows line endings.
*.ps1 text eol=crlf

*.png binary
*.gif binary
*.ico binary
*.icns binary
*.bmp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
